{
  "name": "mc-local",
  "version": "0.1.0",
  "private": true,
  "description": "Nine Regions Local Server",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "install:all": "pnpm install",
    "dev": "pnpm -r --parallel run dev",
    "gen": "pnpm -r --parallel run gen",
    "build": "pnpm -r run build",
    "build:share": "pnpm --filter mc-local-share build",
    "build:backend": "pnpm --filter mc-local-backend build",
    "build:frontend": "pnpm --filter mc-local-frontend build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r exec rimraf dist node_modules"
  },
  "devDependencies": {
    "rimraf": "^5.0.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
