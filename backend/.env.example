# ===== 仙剑奇侠传九野 本地服务器 环境变量示例 =====
# 复制为 .env 后按需修改；所有项均有默认值，可直接不配置运行。

# ---- 网络端口 ----
# WS 网关端口（客户端通过 /ver 的 host:port 连接这里）
WS_PORT=8800
# WS 绑定地址（Docker 部署保持 0.0.0.0；本机直跑也可 127.0.0.1）
WS_HOST=0.0.0.0
# WS 握手必须回显的 subprotocol（客户端固定发送 "xj"）
WS_SUBPROTOCOL=xj

# Frida 明文侧信道 UDP 端口（auto_relay.py 转发明文 C2S 到这里）
PLAIN_UDP_PORT=9002
PLAIN_UDP_HOST=0.0.0.0

# HTTP 层端口（/ver、/login、patchlist 静态响应；可选整合）
HTTP_PORT=8080
HTTP_HOST=0.0.0.1

# ---- 协议源 / 生成产物路径（一般不用改）----
PROTOCOL_DIR=protocol/source
REGISTRY_PATH=src/proto/generated/message-registry.json
PACK_MSG_PATH=protocol/source/pack_msg
MOCKS_DIR=src/mocks

# ---- HTTP /ver 响应里的服务器地址（客户端据此连 WS）----
GAME_HOST=127.0.0.1
GAME_PORT=8800
GAME_VER=0.12.786
GAME_CDN=http://127.0.0.1:8080/res/

# ---- 存储后端切换：memory | redis | database ----
STORAGE_DRIVER=memory
# Redis（STORAGE_DRIVER=redis 时生效）
REDIS_URL=redis://127.0.0.1:6379
# 数据库（STORAGE_DRIVER=database 时生效）
DATABASE_URL=postgres://user:pass@127.0.0.1:5432/xj

# ---- 日志 ----
LOG_LEVEL=info
LOG_DIR=logs
# 是否把每条 C2S/S2C 帧全量记录到 jsonl（同参考网关 captures 行为）
RECORD_FRAMES=true
